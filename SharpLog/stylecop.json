{
  "$schema": "https://raw.githubusercontent.com/DotNetAnalyzers/StyleCopAnalyzers/master/StyleCop.Analyzers/StyleCop.Analyzers/Settings/stylecop.schema.json",
  "indentation": {
    "indentationSize": 4,
    "useTabs": false
  },
  "namingConventions": {
    "allowedHungarianPrefixes": [
      "is",
      "has",
      "can"
    ]
  },
  "documentationRules": {
    "companyName": "SharpLog",
    "copyrightText": "Copyright (c) SharpLog Contributors. All rights reserved.",
    "variables": {
      "companyName": "SharpLog",
      "copyrightText": "Copyright (c) SharpLog Contributors. All rights reserved."
    },
    "documentInterfaces": true,
    "documentExposedElements": true,
    "documentInternalElements": false,
    "documentPrivateElements": false,
    "documentInternalMethods": false,
    "documentPrivateMethods": false,
    "includedElements": [
      "namespace",
      "class",
      "struct",
      "interface",
      "enum",
      "delegate",
      "method",
      "property",
      "indexer",
      "field",
      "event"
    ]
  },
  "orderingRules": {
    "elementOrder": [
      "kind",
      "accessibility",
      "constant",
      "static",
      "readonly"
    ],
    "implementInterfacesSeparately": false
  },
  "rules": {
    "SA0001": {
      "enabled": true
    },
    "SA1600": {
      "enabled": false,
      "modifiers": []
    },
    "SA1601": {
      "enabled": false,
      "modifiers": []
    },
    "SA1602": {
      "enabled": true
    },
    "SA1649": {
      "enabled": false
    },
    "SA1633": {
      "enabled": false
    },
    "SA1309": {
      "enabled": true
    },
    "SA1310": {
      "enabled": true
    }
  }
}
